<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Приложение всегда рисуется в тёмной теме (`ThemeMode.dark`), поэтому
         экран запуска чёрный и при светлой теме системы: иначе перед первым
         кадром Flutter вспыхивает белый фон. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Фон системного splash-экрана Android 12+. Атрибут появился в API 31,
             устройства ниже его игнорируют. -->
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <!-- Без этого окно едет вниз, как только экран счёта прячет статус-бар:
             по умолчанию система пускает окно под вырез камеры, лишь пока тот
             целиком накрыт системной панелью. Спрятали панель — вырез оголился,
             и окно получает отступ в его высоту. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <!-- То же, что в `LaunchTheme`: тема окна меняется после первого кадра,
             и режим выреза нужно повторить, иначе он вернётся к умолчанию. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
